{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siancard",
  "workers_dev": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
